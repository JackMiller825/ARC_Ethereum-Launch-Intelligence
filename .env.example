# Public metadata index. No key required.
BLOCKSCOUT_BASE_URL=https://eth.blockscout.com

# Optional dedicated archive RPC. Comma-separated URLs are tried in order.
# Leave blank to use the built-in public fallbacks. Never prefix this with NEXT_PUBLIC_.
ETHEREUM_RPC_URL=

# Optional Postgres for the worker and /api/status. Browser sessions use IndexedDB instead.
DATABASE_URL=

# Worker selection. Pass any ERC-20 when you start the worker. Leave this blank in the repo.
# INDEX_TOKEN=
# INDEX_MINUTES=60
# INDEX_MODE=launch
